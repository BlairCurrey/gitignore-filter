{
  "name": "gitignore-filter",
  "version": "0.1.0",
  "description": "Respect .gitignore (and .prettierignore, etc.) exactly like git does, with tinyglobby, fdir or fs.glob. Tested against git itself.",
  "keywords": [
    "gitignore",
    "ignore",
    "glob",
    "tinyglobby",
    "fdir",
    "globby",
    "git",
    "prettierignore",
    "e18e"
  ],
  "license": "MIT",
  "author": "Blair Currey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlairCurrey/gitignore-filter.git"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "tinyglobby": [
        "./dist/tinyglobby.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tinyglobby": {
      "import": {
        "types": "./dist/tinyglobby.d.mts",
        "default": "./dist/tinyglobby.mjs"
      },
      "require": {
        "types": "./dist/tinyglobby.d.cts",
        "default": "./dist/tinyglobby.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "test": "pnpm run build && pnpm run test:only",
    "test:only": "node --import tsx --test --test-reporter=spec test/api.test.ts test/git-parity.test.ts test/randomized.test.ts",
    "bench": "pnpm run build && node --import tsx bench/bench.ts",
    "size": "node --import tsx bench/size.ts",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test:only"
  },
  "dependencies": {
    "ignore": "^7.0.12"
  },
  "peerDependencies": {
    "tinyglobby": ">=0.2.10"
  },
  "peerDependenciesMeta": {
    "tinyglobby": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fdir": "^6.5.0",
    "globby": "^16.2.4",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
